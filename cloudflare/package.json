{
  "name": "pokemon-consultant-cloudflare",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc",
    "smoke": "node scripts/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply pokemon-master --local",
    "db:migrate:remote": "wrangler d1 migrations apply pokemon-master --remote",
    "db:seed:local": "wrangler d1 execute pokemon-master --local --file=../data/champions/data.sql",
    "db:seed:remote": "wrangler d1 execute pokemon-master --remote --file=../data/champions/data.sql",
    "db:seed:battle:local": "wrangler d1 execute pokemon-master --local --file=../data/battle/battle_data.sql",
    "db:seed:battle:remote": "wrangler d1 execute pokemon-master --remote --file=../data/battle/battle_data.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
